{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "deviceWriters": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$deviceId": {
        ".write": "auth != null && root.child('deviceWriters').child($deviceId).val() === auth.uid",
        "latest": {
          ".validate": "newData.hasChildren(['lat', 'lon', 'ts'])"
        },
        "track": {
          "$ts": {
            ".validate": "newData.hasChildren(['lat', 'lon', 'ts'])"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
